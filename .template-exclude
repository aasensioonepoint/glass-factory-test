# Read by .agents/bin/sync_template.py. One rule per line, `#` comments.
# Prefixes are repo-root-relative; directory rules MUST end in "/".
# Precedence: longest prefix wins; a polarity tie at identical prefix is a config error.

# strip: never taken from main; deleted from the template if present THERE —
# EXCEPT a SEEDED destination: `.agents/state/gates/<NAME>` written by
# sync_template.py from `.agents/adopter-seed/gates/<NAME>` (the seed channel,
# below) is written, never deleted.
strip: .agents/state/
# Prophylactic (matches nothing today): .gemini/backups/ holds transcript
# backups (pre_compact_backup.py) and .gemini/ has no .gitignore — if one is
# ever committed on main it must not travel.
strip: .gemini/backups/
# The front-end SOURCE. `.agents/ui/` is the BUILD OUTPUT of `.agents/ui-src/`
# (React + Vite) and travels, because it is the deliverable a consumer's `/dash`
# serves. The source does NOT travel: a consumer project gets a working
# dashboard, not an npm build chain it never asked for and would have to keep
# green. Rebuilding the front is a KIT maintenance operation, done here on main
# where the toolchain lives — the same split as `.agents/bin/`, which the kit
# maintains for itself and vendors as read-only.
#
# `node_modules/` is git-ignored on top of this, so the rule guards the tracked
# half (JSX, vite.config.js, package.json, smoketest.mjs) rather than the bulk.
#
# THIS RULE IMPLIES A GUARD (T-00000232). Because only the BUILD travels, sources
# edited on main and never rebuilt would ship an adopting project a dashboard
# matching no state of this repo, silently. So `sync_template.py --apply` refuses
# (exit 19) when main's last `.agents/ui-src/` commit is not an ancestor of its
# last `.agents/ui/` commit, and names the rebuild — which must happen HERE, on
# main, since at apply time HEAD is on the template branch where the source does
# not exist. `--allow-stale-build` is the escape; `--check` never refuses.
# The guard measures the ORDER OF COMMITS, not the CONTENT of the bundle:
# committing edited sources and a non-rebuilt bundle in one commit defeats it.
strip: .agents/ui-src/
# T-00000199, pilot decision 2026-08-15: the opt-in that makes npm/pnpm audits
# cover devDependencies. PRESENT in the repos that maintain the kit's own build
# chain (here, and op-agentic-builder by hand), ABSENT everywhere else — a
# consumer never asked for that toolchain and must not be gated on advisories it
# cannot act on. `strip:` is what makes "absent" a guarantee rather than a habit:
# the file can never be taken from main into the template, so it cannot reach an
# adopting project by accident. Mirror of `.agents/protected-paths.local` below:
# the MECHANISM ships from main, the CONTENT lives only where it applies.
strip: .agents/security/audit-dev-deps.local
